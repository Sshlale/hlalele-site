      ]
    }
  };

  // Function to update ritual status
  function updateRitual(id, status) {
    const categories = ["milestones","upgrade_path","survival"];
    categories.forEach(cat => {
      ritualArchive.rituals[cat].forEach(r => {
        if(r.id === id) r.status = status;
      });
    });
    ritualArchive.timestamp = new Date().toISOString();
    console.log("Updated Archive:", ritualArchive);

    // Optional: export JSON to file
    const blob = new Blob([JSON.stringify(ritualArchive,null,2)], {type:"application/json"});
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = "ritual-archive.json";
    link.click();
  }
