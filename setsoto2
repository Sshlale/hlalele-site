function renderWitnessLog() {
  let archive = JSON.parse(localStorage.getItem("ritualArchive"));
  let logList = document.getElementById("witness-log");
  logList.innerHTML = "";

  archive.logs.forEach(entry => {
    let li = document.createElement("li");

    // Style based on type
    if(entry.id === "eternal_export") {
      li.className = "witness-export";
    } else if(entry.status === "complete") {
      li.className = "witness-complete";
    }

    li.textContent = `${entry.timestamp} → ${entry.title || entry.id} [${entry.status}] ${entry.message ? " - " + entry.message : ""}`;
    logList.appendChild(li);
  });
}
