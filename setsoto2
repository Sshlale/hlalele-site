<!DOCTYPE html>
<html>
<head>
  <title>HlaleleDAO Sandbox Ritual Board</title>
  <style>
    body { background-color: indigo; color: white; font-family: 'Segoe UI', sans-serif; margin:0; padding:20px; }
    h1,h2,h3 { color: gold; }
    .progress-bar { width:100%; background:#333; border:2px solid gold; margin:20px 0; }
    .progress { width:60%; height:20px; background:green; }
    .milestones, .panel ul { list-style:none; padding:0; }
    .milestone, .panel li { background:#222; border:2px solid gold; padding:10px; border-radius:8px; margin:10px 0; }
    .panel { margin-top:30px; border:2px solid gold; padding:20px; background:#222; border-radius:10px; }
    label { cursor:pointer; }
  </style>
</head>
<body>
  <h1>HlaleleDAO Sandbox Ritual Board</h1>

  <!-- Progress Bar -->
  <div class="progress-bar"><div class="progress"></div></div>

  <!-- Milestones -->
  <h3>📌 Milestones</h3>
  <ul class="milestones">
    <li><label><input type="checkbox" onchange="updateRitual('github_branch', this.checked?'complete':'pending')"> 🟦⚔️ GitHub → Branch Ritual</label></li>
    <li><label><input type="checkbox" onchange="updateRitual('vercel_preview', this.checked?'complete':'pending')"> 🟩🔥 Vercel → Preview Ritual</label></li>
    <li><label><input type="checkbox" onchange="updateRitual('cloudflare_dns', this.checked?'complete':'pending')"> 🟧🛡️ Cloudflare → DNS Ritual</label></li>
    <li><label><input type="checkbox" onchange="updateRitual('dns_propagation', this.checked?'complete':'pending')"> 🟨🌐 DNS → Propagation Ritual</label></li>
    <li><label><input type="checkbox" onchange="updateRitual('live_breakthrough', this.checked?'complete':'pending')"> 🟪✨ Live → Breakthrough Ritual</label></li>
  </ul>

  <!-- Upgrade Path Panel -->
  <div class="panel">
    <h3>⚡ Upgrade Path Rituals</h3>
    <ul>
      <li><label><input type="checkbox" onchange="updateRitual('cloudflare_upgrade', this.checked?'complete':'pending')"> 🟥⚡ Cloudflare Upgrade</label></li>
      <li><label><input type="checkbox" onchange="updateRitual('gemini_upgrade', this.checked?'complete':'pending')"> 🟦🤖 Gemini Upgrade</label></li>
      <li><label><input type="checkbox" onchange="updateRitual('google_ai_upgrade', this.checked?'complete':'pending')"> 🟩🌐 Google AI Studio Upgrade</label></li>
    </ul>
  </div>

  <!-- Survival Ritual Panel -->
  <div class="panel">
    <h3>🌱 Survival Rituals (Free Tier)</h3>
    <ul>
      <li><label><input type="checkbox" checked disabled> 🟧🔒 Cloudflare Free → Page Rules, HTTPS, Auto Minify, Bot Fight Mode</label></li>
      <li><label><input type="checkbox" checked disabled> 🟦📄 Gemini Free → Docs drafting, Gmail assistance, Meet summaries</label></li>
      <li><label><input type="checkbox" checked disabled> 🟩⚙️ Google AI Studio Free → Prompt experiments, governance scroll prototyping</label></li>
    </ul>
    <p style="color:gold; margin-top:15px;">
      These survival rituals mark your resilience phase — documenting how HlaleleDAO runs lean under constraints.
    </p>
  </div>

  <!-- JSON Export Script -->
  <script>
    let ritualArchive = {
      board: "HlaleleDAO Sandbox Ritual Board",
      timestamp: new Date().toISOString(),
      rituals: { milestones:[], upgrade_path:[], survival:[] }
    };

    function updateRitual(id, status) {
      // Update ritualArchive
      const categories = ["milestones","upgrade_path","survival"];
      categories.forEach(cat => {
        ritualArchive.rituals[cat].forEach(r => { if(r.id===id) r.status=status; });
      });
      ritualArchive.timestamp = new Date().toISOString();
      console.log("Updated Archive:", ritualArchive);

      // Trigger JSON download
      const blob = new Blob([JSON.stringify(ritualArchive,null,2)], {type:"application/json"});
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = "ritual-archive.json";
      link.click();
    }

    // Initialize rituals
    ritualArchive.rituals.milestones = [
      {id:"github_branch",status:"pending",title:"GitHub → Branch Ritual"},
      {id:"vercel_preview",status:"pending",title:"Vercel → Preview Ritual"},
      {id:"cloudflare_dns",status:"pending",title:"Cloudflare → DNS Ritual"},
