<!DOCTYPE html>
<html>
<head>
  <title>HlaleleDAO Sandbox Ritual Board</title>
  <style>
    body { font-family: 'Segoe UI', sans-serif; background:#2E1A47; color:#FDFEFE; }
    h2 { margin:20px; color:#F1C40F; }
    .progress-container {
      width:90%; margin:20px auto; background:#1C0F2E; border-radius:6px; border:1px solid #F1C40F;
    }
    .progress-bar {
      height:20px; background:#2ECC71; width:0%; border-radius:6px;
      text-align:center; color:#FDFEFE; font-size:12px;
    }
    .board { display:flex; gap:20px; margin:20px; }
    .column {
      flex:1; background:#1C0F2E; border:1px solid #F1C40F; border-radius:6px;
      padding:10px; min-height:300px;
    }
    .column h3 { text-align:center; color:#F1C40F; }
    .task {
      background:#FDFEFE; color:#2E1A47; margin:5px; padding:8px; border-radius:4px;
      cursor:grab;
    }
    .dragging { opacity:0.5; }
    .log {
      margin:20px; padding:10px; background:#1C0F2E; border:1px solid #F1C40F;
      border-radius:6px; max-height:200px; overflow-y:auto; color:#FDFEFE;
    }
    button {
      margin:10px; padding:8px 12px; border:none; border-radius:4px;
      background:#F1C40F; color:#2E1A47; cursor:pointer;
    }
    button:hover { background:#C0392B; color:#fff; }
    canvas { margin:20px; background:#1C0F2E; border:1px solid #F1C40F; border-radius:6px; }
  </style>
</head>
<body>
  <h2>📜 HlaleleDAO Sandbox Ritual Board</h2>

  <!-- Progress Tracker -->
  <div class="progress-container">
    <div class="progress-bar" id="progress-bar">0%</div>
  </div>

  <!-- Kanban Columns -->
  <div class="board">
    <div class="column" id="github">
      <h3>⚔️ GitHub</h3>
      <div class="task" draggable="true">Create branch (sandbox-[feature])</div>
      <div class="task" draggable="true">Push branch to origin</div>
      <div class="task" draggable="true">Confirm branch appears in repo</div>
      <div class="task" draggable="true">Note commit ID in Journal</div>
    </div>
    <div class="column" id="vercel">
      <h3>🔥 Vercel</h3>
      <div class="task" draggable="true">Preview URL generated</div>
      <div class="task" draggable="true">Check build logs (no errors)</div>
      <div class="task" draggable="true">Verify entry point exists</div>
      <div class="task" draggable="true">Assign subdomain in Domains tab</div>
    </div>
    <div class="column" id="cloudflare">
      <h3>🛡️ Cloudflare</h3>
      <div class="task" draggable="true">Add CNAME record</div>
      <div class="task" draggable="true">Assign subdomain to branch</div>
      <div class="task" draggable="true">Confirm proxy mode</div>
    </div>
    <div class="column" id="dns">
      <h3>🌐 DNS</h3>
      <div class="task" draggable="true">Run dig sandbox.hlalele.com</div>
      <div class="task" draggable="true">Run nslookup sandbox.hlalele.com</div>
      <div class="task" draggable="true">Confirm resolution to Vercel</div>
      <div class="task" draggable="true">Wait for TTL delays</div>
    </div>
    <div class="column" id="live">
      <h3>✨ Live</h3>
      <div class="task" draggable="true">Visit sandbox.hlalele.com</div>
      <div class="task" draggable="true">Confirm site loads</div>
      <div class="task" draggable="true">Log timestamp in Journal</div>
      <div class="task" draggable="true">Export Deployment History JSON</div>
    </div>
  </div>

  <!-- Timestamp Log + Export -->
  <div class="log" id="log">
    <h4>🕒 Sandbox History</h4>
    <ul id="log-list"></ul>
    <button onclick="exportLog()">📂 Export Log</button>
  </div>

  <!-- Chart -->
  <canvas id="chart" width="600" height="300"></canvas>

  <script>
    const tasks = document.querySelectorAll('.task');
    const columns = document.querySelectorAll('.column');
    const progressBar = document.getElementById('progress-bar');
    const logList = document.getElementById('log-list');
    const chartCanvas = document.getElementById('chart');
    const ctx = chartCanvas.getContext('2d');
    let history = [];

    tasks.forEach(task => {
      task.addEventListener('dragstart', () => {
        task.classList.add('dragging');
      });
      task.addEventListener('dragend', () => {
        task.classList.remove('dragging');
        updateProgress();
      });
    });

    columns.forEach(column => {
      column.addEventListener('dragover', e => {
        e.preventDefault();
        const dragging = document.querySelector('.dragging');
        if (dragging) column.appendChild(dragging);
      });
      column.addEventListener('drop', e => {
        const dragging = document.querySelector('.dragging');
        if (dragging && column.id === 'live') {
          logTimestamp(dragging.textContent);
          drawChart();
        }
      });
    });

    function updateProgress() {
      const totalTasks = document.querySelectorAll('.task').length;
      const liveTasks = document.querySelectorAll('#live .task').length;
      const percent = Math.round((liveTasks / totalTasks) * 100);
      progressBar.style.width = percent + '%';
      progressBar.textContent = percent + '%';
    }

    function logTimestamp(taskName) {
      const now = new Date();
      const timestamp = now.toLocaleString();
      const entry = { task: taskName, time: timestamp };
      history.push(entry);
      const li = document.createElement('li');
      li.textContent = `${taskName} → moved to Live at ${timestamp}`;
      logList.appendChild(li);
    }

    function exportLog() {
      const blob = new Blob([JSON.stringify(history, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "sandbox-history.json";
      a.click();
      URL.revokeObjectURL(url);
    }

    function drawChart() {
      ctx.clearRect(0, 0, chartCanvas.width, chartCanvas.height);
      ctx.beginPath();
      ctx.moveTo(50, 250);
      history.forEach((entry, i) => {
        const x = 50 + i * 80;
        const y = 250 - (i+1) * 30;
        ctx.lineTo(x, y);
        ctx.arc(x, y, 4, 0, Math.PI*2);
        ctx.fillStyle = "#F1C40F";
        ctx.fill();
        ctx.fillText(entry.task, x-30, y-10);
      });
      ctx.strokeStyle = "#2ECC71";
      ctx.stroke();
    }
  </script>
</body>
</html>
