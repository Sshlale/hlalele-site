@keyframes pulseGlow {
  0% { box-shadow: 0 0 12px gold, 0 0 20px green; }
  50% { box-shadow: 0 0 25px gold, 0 0 40px green; transform: scale(1.08); }
  100% { box-shadow: 0 0 12px gold, 0 0 20px green; transform: scale(1); }
}

.export-btn {
  margin-top: 20px;
  padding: 12px 20px;
  font-size: 1.1em;
  font-weight: bold;
  background: linear-gradient(135deg, green 40%, gold 100%);
  color: indigo;
  border: 3px solid gold;
  border-radius: 12px;
  cursor: pointer;
  animation: pulseGlow 2s infinite;
  transition: transform 0.2s ease, box-shadow 0.3s ease;
}
<button onclick="exportArchive()" class="export-btn">
  🔥📜 Export Eternal Archive
</button>
<script>
  // Initialize archive in localStorage if not present
  if(!localStorage.getItem("ritualArchive")){
    localStorage.setItem("ritualArchive", JSON.stringify({
      board: "HlaleleDAO Sandbox Ritual Board",
      logs: []
    }));
  }

  function updateRitual(id, status) {
    let archive = JSON.parse(localStorage.getItem("ritualArchive"));
    let entry = {
      id: id,
      status: status,
      timestamp: new Date().toISOString()
    };
    archive.logs.push(entry);
    localStorage.setItem("ritualArchive", JSON.stringify(archive));
    console.log("Archive Updated:", archive);
  }

  // Export function with ceremonial log
  function exportArchive() {
    let archive = JSON.parse(localStorage.getItem("ritualArchive"));

    // Add ceremonial invocation entry
    archive.logs.push({
      id: "eternal_export",
      status: "invoked",
      message: "🔥 Eternal Archive invoked",
      timestamp: new Date().toISOString()
    });

    // Save back to localStorage
    localStorage.setItem("ritualArchive", JSON.stringify(archive));

    // Trigger download
    const blob = new Blob([JSON.stringify(archive,null,2)], {type:"application/json"});
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = "eternal-ritual-archive.json";
    link.click();

    console.log("Eternal Archive Exported:", archive);
  }
</script>
