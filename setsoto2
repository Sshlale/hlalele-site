<script>
  function renderWitnessLog() {
    let archive = JSON.parse(localStorage.getItem("ritualArchive"));
    let logList = document.getElementById("witness-log");
    logList.innerHTML = "";

    archive.logs.forEach(entry => {
      let li = document.createElement("li");
      li.textContent = `${entry.timestamp} → ${entry.title || entry.id} [${entry.status}] ${entry.message ? " - " + entry.message : ""}`;
      logList.appendChild(li);
    });
  }

  // Call render after each update
  function updateRitual(id, status) {
    let archive = JSON.parse(localStorage.getItem("ritualArchive"));
    let entry = { id:id, status:status, title:id, timestamp:new Date().toISOString() };
    archive.logs.push(entry);
    localStorage.setItem("ritualArchive", JSON.stringify(archive));
    renderWitnessLog();
  }

  function exportArchive() {
    let archive = JSON.parse(localStorage.getItem("ritualArchive"));
    archive.logs.push({
      id:"eternal_export",
      status:"invoked",
      message:"🔥 Eternal Archive invoked",
      timestamp:new Date().toISOString()
    });
    localStorage.setItem("ritualArchive", JSON.stringify(archive));
    renderWitnessLog();

    const blob = new Blob([JSON.stringify(archive,null,2)], {type:"application/json"});
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = "eternal-ritual-archive.json";
    link.click();
  }

  // Render logs on page load
  window.onload = renderWitnessLog;
</script>
#witness-log li {
  margin: 8px 0;
  padding: 6px;
  border-radius: 6px;
  font-size: 0.95em;
}

.witness-complete {
  color: #00ff7f; /* emerald green */
  text-shadow: 0 0 6px #00ff7f;
}

.witness-export {
  color: gold;
  text-shadow: 0 0 8px gold;
}
function renderWitnessLog() {
  let archive = JSON.parse(localStorage.getItem("ritualArchive"));
  let logList = document.getElementById("witness-log");
  logList.innerHTML = "";

  archive.logs.forEach(entry => {
    let li = document.createElement("li");

    // Style based on type
    if(entry.id === "eternal_export") {
      li.className = "witness-export";
    } else if(entry.status === "complete") {
      li.className = "witness-complete";
    }

    li.textContent = `${entry.timestamp} → ${entry.title || entry.id} [${entry.status}] ${entry.message ? " - " + entry.message : ""}`;
    logList.appendChild(li);
  });
}
